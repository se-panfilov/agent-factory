{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-factory.local/schemas/installer-release.schema.json",
  "title": "factory-setup installer release lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "installer",
    "node",
    "npm",
    "docker",
    "tailscale",
    "codex",
    "images",
    "sources",
    "qualification"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_version": { "const": "1.0.0" },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_url", "sha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^24\\.[0-9]+\\.[0-9]+$" },
        "source_url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "npm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ce", "cli", "containerd", "buildx", "compose"],
      "properties": {
        "ce": { "type": "string", "minLength": 1 },
        "cli": { "type": "string", "minLength": 1 },
        "containerd": { "type": "string", "minLength": 1 },
        "buildx": { "type": "string", "minLength": 1 },
        "compose": { "type": "string", "minLength": 1 }
      }
    },
    "tailscale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "integrity"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "minLength": 1 }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_image_platform_digest", "agent_image_digest"],
      "properties": {
        "base_image_platform_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "agent_image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_fingerprints", "official_urls"],
      "properties": {
        "trusted_fingerprints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "official_urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "uniqueItems": true
        }
      }
    },
    "artifact_sizes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_tarball_bytes"],
      "properties": {
        "node_tarball_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "setup_release_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_refs"],
      "properties": {
        "report_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
