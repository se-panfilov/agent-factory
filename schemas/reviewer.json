{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "input_sha",
    "summary",
    "blockers",
    "role",
    "candidate_sha",
    "verdict",
    "findings",
    "checks_needed"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "task_id": {
      "type": "string"
    },
    "input_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "summary": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": "string",
      "enum": [
        "reviewer"
      ]
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "accept",
        "changes_requested",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "observation",
          "evidence"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "checks_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
