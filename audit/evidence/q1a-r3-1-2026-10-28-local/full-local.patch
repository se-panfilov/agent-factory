+        print(json.dumps({"verdict": "HARNESS_INCOMPLETE_OR_INVALID", "error": str(exc)}))
+        return 70
+    print(json.dumps(result, indent=2))
+    return 1 if args.mode == "desired" and any(r["desired_fail"] for r in result) else 0
