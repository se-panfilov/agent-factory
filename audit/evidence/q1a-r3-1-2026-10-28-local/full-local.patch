+    try { hashes[name] = crypto.createHash('sha256').update(await fs.readFile(path.join(x.config.paths.setup_state_dir,name))).digest('hex'); }
+    catch(e) { if(e.code !== 'ENOENT')throw e;hashes[name]=null; }
