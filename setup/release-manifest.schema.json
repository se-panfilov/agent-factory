{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-factory.local/schemas/release-manifest.schema.json",
  "title": "factory-setup release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "setup_version",
    "source_commit",
    "created_at",
    "files",
    "versions_lock_sha256",
    "bootstrap_manifest_sha256",
    "archive",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_version": { "const": "1.0.0" },
    "setup_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!\\.\\.?($|/))(?!.*\\/\\.\\.?($|/)).+$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "versions_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bootstrap_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "size_bytes"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.tar\\.xz$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "algorithm", "key_id"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.sig$"
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
