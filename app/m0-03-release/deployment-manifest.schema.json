{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-factory.local/schemas/m0-03/deployment-manifest.schema.json",
  "title": "M0.3 deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application_version",
    "source_commit",
    "content_hashes",
    "node_range",
    "capabilities",
    "commands",
    "config_schema_version",
    "state_schema_version",
    "migrations",
    "security_evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "application_version": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "content_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "node_range": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "runner-readonly"
        ]
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_run",
        "runner_status",
        "runner_stop",
        "verify_fake"
      ],
      "properties": {
        "runner_run": {
          "$ref": "#/$defs/argv"
        },
        "runner_status": {
          "$ref": "#/$defs/argv"
        },
        "runner_stop": {
          "$ref": "#/$defs/argv"
        },
        "verify_fake": {
          "$ref": "#/$defs/argv"
        }
      }
    },
    "config_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "state_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "security_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
