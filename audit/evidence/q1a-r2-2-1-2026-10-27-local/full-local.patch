+expected={
+ 'context-boundary-probes.jsonl': [f'gate-after-probe-{k}-{m}' for k in ['lock','config','plan'] for m in ['control','fault']]+[f'effect-during-final-context-{k}-{m}' for k in ['config','plan'] for m in ['control','fault']],
