+      load('src/core/plan').createRegistry([r14Noop('S02'),load('src/stages/access').createAccessStage(adapter)]));
+  };
+  const original=await x.planAndApprove(make());
+  const first=await make().run('apply',x.applyOptions);
+  activeRepo=path.resolve(process.argv[3]);
